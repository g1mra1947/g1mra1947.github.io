(*
 G1MRA website macro definitions (c) Adrian Johnstone 2025, 2026
 Also see:
  events.amp for event lists
  groups.amp for group pags
  links.amp for interesting links
  suppliers.amp for suppliers
  (en, fr, de).amp for multi-lingual text blocks - en.amp is source; others are generated by Google Translate 
*)

(* Placeholder for upcoming pages *)
NA{^h1{^em{Coming soon}}}

(* A macro that expands to nothing *)
empty{}

(* Headings *)
h1(str){<h1>^str</h1>}
h1Tag(str tag){<h1 id="^tag">^str</h1>}
h2(str){<h2>^str</h2>}
h2Tag(str tag){<h2 id="^tag">^str</h2>}
h3(str){<h3>^str</h3>}

(* Text layout *)
nl{<br>}                                       // new line
vgap{<p style="padding-bottom:40px"></p>}      // vertical padding space
vskip{<p></p>}                                 // paragraph space
us{_}                                          // underscore
identity(body){^body}                          // identity macro for contiguous text after constant macro
hgap{<p style="padding-right:20px"></p>}       // padding space
quad{&emsp;}                                   // fixed space
hrule{<div style="flex-basis:100%"><hr></div>} // horizontal rule
em(body){<em>^body</em>}                       // emphasise (usually italics depending on browser and style)	
bf*(body){<b>^body</b>}                         // bold font

(* Displays *)
itemise(body){<ul>^body</ul>}
enumerate(body){<ol>^body</ol>}
item(body){<li>^body</li>}

(* Box layout *)
hbox*(body){<div class=hbox>^body</div><!-- close hbox -->} // Horizontally flowing box
vbox*(body){<div class=vbox>^body</div><!-- close vbox -->} // Vertically flowing box
cbox*(body){<div class=cbox>^body</div><!-- close cbox -->} // Centred box

wbox*(body){<div class=wbox>^body</div><!-- close wbox -->} // Wide text block 350-1000 px
tbox*(body){<div class=tbox>^body</div><!-- close tbox -->} // Standad text block 350-700 px
sbox(body){<div class=sbox>^body</div><!-- close sbox -->}  // Sidebar box 300px
zbox(body){<div class=zbox>^body</div><!-- close zbox -->}  // Sidebar box 300px

fill{<div class="fill"></div>}

(* Links *)
link(label target){<a href="^target">^bf{^label}</a>}
tlink(label target){<a href="^target">^label</a>}
imagePlain(img txt){<img src="^img" alt="^txt" title="^txt">}
img(img txt){<img src="images/thumbs/^img" alt="^txt" title="^txt">}
image(img txt){<a href="images/^img"><img src="images/thumbs/^img" alt="^txt" title="^txt"></a>}
imageBar(b1 b2 b3){<div class="imageBar">^b1 ^b2 ^b3 </div><!-- close imageBar -->}
imageBar1(b){<div class="imageBar">^b</div><!-- close imageBar -->}
g1domain{g1mra.com}
g1mail(address){<a href="mailto:^address@^g1domain">^address@^g1domain</a>}
mail(address){<a href="mailto:^address">^address</a>}
postcode(maj min){^link{^maj ^min}{https://www.google.co.uk/maps/search/^maj+^min}}
caption(txt){alt="^txt" title="^txt"}

(* Events *)
eventDate(date){^h2{^date}}
event(title location text){^bf{^title}^nl^location^nl^em{^text}^hrule}
eventMO(title location text){^bf{^title (Members only)}^nl^location^nl^em{^text}^hrule}

(* Groups *)
groupWeb(name email web){

^bf{^link{^name}{^web}}^quad^g1mail{^email-group}}

group(name email web){
^page{^email-group}{^name}{^groupsPrimary}{^groupsSecondary}{^cbox{^tbox{^h1{^name}
^PAR{This is a placeholder; for information please email ^g1mail{^email-group}}}}}
^bf{^link{^name}{^email-group^us^lang.html}}^quad^g1mail{^email-group}^nl}

(* G1MRA page setup *)
pagePrelude(name description){
<!-- G1MRA page by Adrian Johnstone a.johnstone@rhul.ac.uk built ^NOW -->
<head>
<link rel="stylesheet" href="g1mra.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta charset="UTF-8">
<html lang="^lang">
<title>^name</title>
<meta name="description" content="^description">
</head>
<body>
<div style="display:flex; justify-content:center; flex-direction:row; flex-wrap: wrap;">
<div style="flex-basis:1024px">
}

pagePostlude{</div></div></body></html>}

navBar(name menuPrim menuSec){
<div class=navbar><a href="Home^us^lang.html"><img src="images/g1mra-logo-75.png" style="width: 80px;" title="Home page"></a>
^vbox{^hbox{^menuPrim}^hrule^hbox{^menuSec}}
^fill
<div class="flags">
  <a href="^name^us^identity{en}.html"><img src="images/Flag_of_the_United_Kingdom_(3-5).svg" title="Select English site"></a>
  <a href="^name^us^identity{de}.html"><img src="images/Flag_of_Germany_(RGB).svg" title="Select German site"></a>
  <a href="^name^us^identity{fr}.html"><img src="images/Flag_of_France_(2024-present).svg" title="Select French site"></a>
</div><!-- close flags -->
</div><!-- close navbar	 -->
}


page*(name description menuPrim menuSec body){^OUT{^name^us^lang.html}{
^pagePrelude{^name}{^description}
^vbox{^navBar{^name}{^menuPrim}{^menuSec}^body}
^pagePostlude
}}

pageWithImages(name description menuPrim menuSec image1 image2 image3 body){^OUT{^name^us^lang.html}{
^pagePrelude{^name}{^description}
^vbox{^navBar{^name}{^menuPrim}{^menuSec}^imageBar{^image1}{^image2}{^image3}^body}
^pagePostlude
}}

connection(webAddress name info){
^PAR{
^link{^bf{^name}}{^webAddress} ^info
}
}


