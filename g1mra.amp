(* Menus *********************************************************************)
active(body){<div style="color:mediumseagreen;">^body</div>}
menEl(label target){^tlink{^label}{^target^us^lang.html}}        
menElA(label target){^tlink{^active{^label}}{^target^us^lang.html}}  // Menu element active
menFlag(target icon hover){<a href="	^target"><img src="images/^icon" style="height: 30px; padding: 4px 2px;" ^caption{^hover}></a>}

homePrimary{^menEl{^T{Events}}{Events}^menEl{^T{Groups}}{Groups}^menEl{^T{Resources}}{Resources}^menEl{^T{Sales}}{Sales}^menEl{^T{Showcase}}{Showcase}^menEl{^T{Contact}}{Contact}^menEl{^T{Join}}{Join}}

eventsPrimary{^menElA{^T{Events}}{Events}^menEl{^T{Groups}}{Groups}^menEl{^T{Resources}}{Resources}^menEl{^T{Sales}}{Sales}^menEl{^T{Showcase}}{Showcase}^menEl{^T{Contact}}{Contact}^menEl{^T{Join}}{Join}}

eventsSecondary{^menEl{^T{Spring show}}{Spring}^menEl{^T{Gauge 1 North}}{G1North}^menEl{^T{Autumn show and AGM}}{AGM}^menEl{^T{Galleries}}{Galleries}}

springSecondary{^menElA{^T{Spring show}}{Spring}^menEl{^T{Gauge 1 North}}{G1North}^menEl{^T{Autumn show and AGM}}{AGM}^menEl{^T{Galleries}}{Galleries}}

g1NorthSecondary{^menEl{^T{Spring show}}{Spring}^menElA{^T{Gauge 1 North}}{G1North}^menEl{^T{Autumn show and AGM}}{AGM}^menEl{^T{Galleries}}{Galleries}}

agmSecondary{^menEl{^T{Spring show}}{Spring}^menEl{^T{Gauge 1 North}}{G1North}^menElA{^T{Autumn show and AGM}}{AGM}^menEl{^T{Galleries}}{Galleries}}

gallerySecondary{^menEl{^T{Spring show}}{Spring}^menEl{^T{Gauge 1 North}}{G1North}^menEl{^T{Autumn show and AGM}}{AGM}^menElA{^T{Galleries}}{Galleries}}

groupsPrimary{^menEl{^T{Events}}{Events}^menElA{^T{Groups}}{Groups}^menEl{^T{Resources}}{Resources}^menEl{^T{Sales}}{Sales}^menEl{^T{Showcase}}{Showcase}^menEl{^T{Contact}}{Contact}^menEl{^T{Join}}{Join}}
groupsSecondary{
^menFlag{#flag_au}{Flag_of_Australia_(converted).svg}{Jump to Australian groups}
^menFlag{#flag_ca}{Flag_of_Canada_(Pantone).svg}{Jump to Canadian groups}
^menFlag{#flag_dk}{Flag_of_Denmark.svg}{Jump to Danish groups}
^menFlag{#flag_fr}{Flag_of_France_(2024-present).svg}{Jump to French groups}
^menFlag{#flag_de}{Flag_of_Germany_(RGB).svg}{Jump to German groups}
^menFlag{#flag_nl}{Flag_of_the_Netherlands.svg}{Jump to Netherlands groups}
^menFlag{#flag_nz}{Flag_of_New_Zealand.svg}{Jump to New Zealand groups}
^menFlag{#flag_za}{Flag_of_South_Africa.svg}{Jump to South African groups}
^menFlag{#flag_ch}{Flag_of_Switzerland_(Pantone).svg}{Jump to Swiss groups}
^menFlag{#flag_uk}{Flag_of_the_United_Kingdom_(3-5).svg}{Jump to UK groups}
^menFlag{#flag_us}{Flag_of_the_United_States_(DoS_ECA_Color_Standard).svg}{Jump to US groups}
^menFlag{#flag_ww}{Globe_icon.svg.png}{Jump to global special-interest groups}
}
